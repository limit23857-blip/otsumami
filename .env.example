# ローカル開発用の例。コピーして .env を作る: cp .env.example .env
# 本番（Supabase）の接続文字列は .env にだけ書き、Git には絶対に入れない
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/otsumami?schema=public"

# Supabase の管理画面 → Project Settings → API Keys / Data API で確認できる（公開して問題ない値）
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxxxxxxx"

# Anthropic Console → API Keys で発行（絶対にコミットしない）
ANTHROPIC_API_KEY="sk-ant-xxxxxxxx"
